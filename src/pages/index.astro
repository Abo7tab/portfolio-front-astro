---
import BaseLayout from '../layouts/BaseLayout.astro';
import Preloader from '../components/Preloader.astro';
import CanvasBackground from '../components/ui/CanvasBackground';
import HireMe from '../components/HireMe.astro';
import Footer from '../components/Footer.astro';
import Modals from '../components/Modals.astro';
---

<BaseLayout>

  <!-- Preloader -->
  <Preloader />

  <!-- 3D Shader Background (React) -->
  <CanvasBackground client:load />

  <!-- Modals -->
  <Modals />

  <!-- ══════════════════════════════════════
       Main Wrapper (hidden until loaded)
       ══════════════════════════════════════ -->
  <div class="main-wrapper" id="main-content">

    <!-- ────────── HEADER / PROFILE ────────── -->
    <header>
      <div class="container profile">

        <!-- Profile Photo + Name + Social — Side-by-Side Layout -->
        <div class="profile-data">

          <!-- LEFT: Avatar -->
          <div class="profile-avatar-col">
            <!-- Skeleton: Avatar -->
            <div class="imgBx reveal-scale" id="skeleton-avatar-wrap" style="transition-delay: 0ms;">
              <div class="skeleton skeleton-avatar" style="width:100%;height:100%;border-radius:50%;"></div>
            </div>
            <!-- Real: Avatar (hidden until loaded) -->
            <div class="imgBx reveal-scale" id="real-avatar-wrap" style="transition-delay: 0ms; display:none;">
              <img src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
                   alt="Mohamed Emad Ali" width="160" height="160"
                   class="profile-img" id="profile-img"
                   data-bs-toggle="modal" data-bs-target="#profileModal" />
            </div>
          </div>

          <!-- RIGHT: Name + Title + Bio + Socials -->
          <div class="profile-info-col">
            <!-- Skeleton: Name + Title -->
            <div id="skeleton-profile-text">
              <div class="skeleton skeleton-title" style="width:240px;height:28px;margin:0 auto 10px;"></div>
              <div class="skeleton skeleton-text-sm" style="width:180px;height:16px;margin:0 auto 12px;"></div>
            </div>
          <!-- Real: Name + Title -->
          <h1 class="name reveal-left" id="profile-name" style="transition-delay:100ms; display:none;">
            Mohamed Emad Ali
            <span class="fb-verified-badge" title="Verified Profile">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" class="fb-verified-icon">
                <path fill-rule="evenodd" clip-rule="evenodd" d="M10.5213 2.62368C11.3147 1.75251 12.6853 1.75251 13.4787 2.62368L14.4989 3.74391C14.8973 4.18137 15.4746 4.4202 16.0645 4.39121L17.5724 4.31711C18.7441 4.25953 19.7405 5.25588 19.6829 6.42761L19.6088 7.93551C19.5798 8.52538 19.8186 9.10266 20.2561 9.50113L21.3763 10.5213C22.2475 11.3147 22.2475 12.6853 21.3763 13.4787L20.2561 14.4989C19.8186 14.8973 19.5798 15.4746 19.6088 16.0645L19.6829 17.5724C19.7405 18.7441 18.7441 19.7405 17.5724 19.6829L16.0645 19.6088C15.4746 19.5798 14.8973 19.8186 14.4989 20.2561L13.4787 21.3763C12.6853 22.2475 11.3147 22.2475 10.5213 21.3763L9.50113 20.2561C9.10266 19.8186 8.52538 19.5798 7.93551 19.6088L6.42761 19.6829C5.25588 19.7405 4.25953 18.7441 4.31711 17.5724L4.39121 16.0645C4.4202 15.4746 4.18137 14.8973 3.74391 14.4989L2.62368 13.4787C1.75251 12.6853 1.75251 11.3147 2.62368 10.5213L3.74391 9.50113C4.18137 9.10266 4.4202 8.52538 4.39121 7.93551L4.31711 6.42761C4.25953 5.25588 5.25588 4.25953 6.42761 4.31711L7.93551 4.39121C8.52538 4.4202 9.10266 4.18137 9.50113 3.74391L10.5213 2.62368Z" fill="#0084FF"/>
                <path d="M9.75 12.25L11.25 13.75L15.25 9.75" stroke="white" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </h1>
          <h2 class="profession reveal-right" id="profile-profession" style="transition-delay:200ms; display:none;">DevOps & Network Engineer</h2>
          <p class="profile-bio reveal-up" id="profile-bio" style="display:none; transition-delay:300ms;"></p>

          <!-- Skeleton: Socials -->
          <div id="skeleton-socials" style="display:flex;gap:12px;justify-content:center;margin-top:8px;">
            <div class="skeleton" style="width:46px;height:46px;border-radius:50%;"></div>
            <div class="skeleton" style="width:46px;height:46px;border-radius:50%;"></div>
            <div class="skeleton" style="width:46px;height:46px;border-radius:50%;"></div>
          </div>
          <!-- Real: Socials -->
          <div class="socials reveal-scale" id="socials-container" style="transition-delay:400ms; display:none;"></div>

          <!-- Skeleton: Stats -->
          <div class="skeleton-stats-row reveal-up" id="skeleton-stats" style="transition-delay:500ms;">
            <div class="skeleton-stat-item">
              <div class="skeleton skeleton-stat"></div>
              <div class="skeleton skeleton-text-xs" style="width:60px;"></div>
            </div>
            <div class="skeleton-stat-item">
              <div class="skeleton skeleton-stat"></div>
              <div class="skeleton skeleton-text-xs" style="width:70px;"></div>
            </div>
            <div class="skeleton-stat-item">
              <div class="skeleton skeleton-stat"></div>
              <div class="skeleton skeleton-text-xs" style="width:65px;"></div>
            </div>
          </div>
          <!-- Real: Stats -->
          <div class="profile-info reveal-up" id="real-stats" style="transition-delay:500ms; display:none;">
            <div class="info-item">
              <h3 class="number" id="years-exp">0</h3>
              <p class="desc">Years of<br/>work</p>
            </div>
            <div class="info-item">
              <h3 class="number" id="completed-projects">+0</h3>
              <p class="desc">Completed<br/>projects</p>
            </div>
            <div class="info-item">
              <h3 class="number" id="satisfied-clients">0</h3>
              <p class="desc">Satisfied<br/>customers</p>
            </div>
          </div>

          <!-- Skeleton: CV Buttons -->
          <div id="skeleton-btns" style="display:flex;gap:12px;margin-top:12px;">
            <div class="skeleton skeleton-btn"></div>
            <div class="skeleton skeleton-btn"></div>
          </div>
          <!-- Real: CV Buttons -->
          <div class="profile-btns reveal-scale" id="real-btns" style="transition-delay:600ms; display:none;">
            <div class="cv-download-capsule" id="cv-capsule" style="display:none;">
              <span class="cv-capsule-label">
                <i class="ri-file-user-line"></i> Download CV
              </span>
              <div class="cv-capsule-divider"></div>
              <a href="#" class="cv-split-btn cv-web-split" id="cv-web-btn" target="_blank" rel="noopener noreferrer" download="" style="display:none;">
                <span class="cv-split-icon"><i class="ri-code-s-slash-line"></i></span>
                <span class="cv-split-text">
                  <span class="cv-split-label">Web Dev</span>
                  <span class="cv-split-badge">PDF</span>
                </span>
                <i class="ri-download-line cv-dl-arrow"></i>
              </a>
              <div class="cv-inner-divider" id="cv-inner-divider" style="display:none;"></div>
              <a href="#" class="cv-split-btn cv-net-split" id="cv-network-btn" target="_blank" rel="noopener noreferrer" download="" style="display:none;">
                <span class="cv-split-icon"><i class="ri-shield-keyhole-line"></i></span>
                <span class="cv-split-text">
                  <span class="cv-split-label">Network</span>
                  <span class="cv-split-badge cv-split-badge--net">PDF</span>
                </span>
                <i class="ri-download-line cv-dl-arrow"></i>
              </a>
            </div>
          </div>

          </div><!-- /.profile-info-col -->
        </div><!-- /.profile-data -->

      </div>
    </header>

    <!-- ────────── MAIN CONTENT ────────── -->
    <main>
      <div class="container py-4">

        <!-- ══════ CERTIFICATES SECTION ══════ -->
        <section id="certificates">

          <!-- Section Heading -->
          <div class="section-heading">
            <div class="section-tag">
              <i class="ri-award-line"></i> Credentials
            </div>
            <h2 class="section-title">Certificates &amp; Achievements</h2>
            <p class="section-subtitle">Verified certifications in development, cloud, and security</p>
          </div>

          <!-- Certificate Category Tabs -->
          <ul class="nav nav-pills cert-tabs justify-content-center mb-5 reveal-right" id="certTab" role="tablist" style="transition-delay:800ms;">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" id="web-tab" data-bs-toggle="pill" data-bs-target="#pane-web"
                      type="button" role="tab" aria-controls="pane-web" aria-selected="true">
                <i class="ri-code-s-slash-line me-2"></i>Programming &amp; Development
              </button>
            </li>
            <li class="nav-item" role="presentation" id="cert-tab-net-li">
              <button class="nav-link" id="net-tab" data-bs-toggle="pill" data-bs-target="#pane-net"
                      type="button" role="tab" aria-controls="pane-net" aria-selected="false">
                <i class="ri-shield-keyhole-line me-2"></i>Networking &amp; Cyber Security
              </button>
            </li>
          </ul>

          <!-- Certificate Tab Panes -->
          <div class="tab-content cert-tab-content" id="certTabContent">

            <!-- Programming Pane -->
            <div class="tab-pane fade show active" id="pane-web" role="tabpanel" aria-labelledby="web-tab">
              <div class="row g-4" id="cert-grid-web">
                <!-- Skeleton: 3 certificate cards -->
                <div class="col-12 col-md-6 col-lg-4">
                  <div class="skeleton-cert-card">
                    <div class="skeleton skeleton-cert-img"></div>
                    <div class="skeleton-cert-body">
                      <div class="skeleton skeleton-title" style="width:80%;"></div>
                      <div class="skeleton skeleton-text"></div>
                      <div class="skeleton skeleton-text-sm"></div>
                      <div class="skeleton skeleton-btn" style="width:100%;margin-top:12px;"></div>
                    </div>
                  </div>
                </div>
                <div class="col-12 col-md-6 col-lg-4">
                  <div class="skeleton-cert-card">
                    <div class="skeleton skeleton-cert-img"></div>
                    <div class="skeleton-cert-body">
                      <div class="skeleton skeleton-title" style="width:65%;"></div>
                      <div class="skeleton skeleton-text"></div>
                      <div class="skeleton skeleton-text-sm"></div>
                      <div class="skeleton skeleton-btn" style="width:100%;margin-top:12px;"></div>
                    </div>
                  </div>
                </div>
                <div class="col-12 col-md-6 col-lg-4">
                  <div class="skeleton-cert-card">
                    <div class="skeleton skeleton-cert-img"></div>
                    <div class="skeleton-cert-body">
                      <div class="skeleton skeleton-title" style="width:75%;"></div>
                      <div class="skeleton skeleton-text"></div>
                      <div class="skeleton skeleton-text-sm"></div>
                      <div class="skeleton skeleton-btn" style="width:100%;margin-top:12px;"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Networking Pane -->
            <div class="tab-pane fade" id="pane-net" role="tabpanel" aria-labelledby="net-tab">
              <div class="row g-4" id="cert-grid-net">
                <div class="col-12 col-md-6 col-lg-4">
                  <div class="skeleton-cert-card">
                    <div class="skeleton skeleton-cert-img"></div>
                    <div class="skeleton-cert-body">
                      <div class="skeleton skeleton-title" style="width:70%;"></div>
                      <div class="skeleton skeleton-text"></div>
                      <div class="skeleton skeleton-text-sm"></div>
                      <div class="skeleton skeleton-btn" style="width:100%;margin-top:12px;"></div>
                    </div>
                  </div>
                </div>
                <div class="col-12 col-md-6 col-lg-4">
                  <div class="skeleton-cert-card">
                    <div class="skeleton skeleton-cert-img"></div>
                    <div class="skeleton-cert-body">
                      <div class="skeleton skeleton-title" style="width:60%;"></div>
                      <div class="skeleton skeleton-text"></div>
                      <div class="skeleton skeleton-text-sm"></div>
                      <div class="skeleton skeleton-btn" style="width:100%;margin-top:12px;"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

          </div>
        </section>

        <!-- ══════ PROJECTS SECTION ══════ -->
        <section id="projects" style="display:none;">

          <!-- Section Heading -->
          <div class="section-heading">
            <div class="section-tag">
              <i class="ri-code-box-line"></i> Portfolio
            </div>
            <h2 class="section-title">Featured Projects</h2>
            <p class="section-subtitle">A showcase of software, networks, and web applications I've built</p>
          </div>
          <div class="row g-4" id="projects-grid">
            <!-- Skeleton: 3 project cards -->
            <div class="col-12 col-md-6">
              <div class="skeleton-card">
                <div class="skeleton skeleton-img"></div>
                <div class="skeleton-card-body">
                  <div class="skeleton skeleton-title"></div>
                  <div class="skeleton skeleton-text"></div>
                  <div class="skeleton skeleton-text"></div>
                  <div class="skeleton skeleton-text-sm"></div>
                  <div style="display:flex;gap:8px;margin-top:12px;">
                    <div class="skeleton skeleton-badge"></div>
                    <div class="skeleton skeleton-badge"></div>
                    <div class="skeleton skeleton-badge"></div>
                  </div>
                  <div class="skeleton skeleton-btn" style="width:100%;margin-top:16px;"></div>
                </div>
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="skeleton-card">
                <div class="skeleton skeleton-img"></div>
                <div class="skeleton-card-body">
                  <div class="skeleton skeleton-title" style="width:60%;"></div>
                  <div class="skeleton skeleton-text"></div>
                  <div class="skeleton skeleton-text"></div>
                  <div class="skeleton skeleton-text-sm"></div>
                  <div style="display:flex;gap:8px;margin-top:12px;">
                    <div class="skeleton skeleton-badge"></div>
                    <div class="skeleton skeleton-badge"></div>
                  </div>
                  <div class="skeleton skeleton-btn" style="width:100%;margin-top:16px;"></div>
                </div>
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="skeleton-card">
                <div class="skeleton skeleton-img"></div>
                <div class="skeleton-card-body">
                  <div class="skeleton skeleton-title" style="width:75%;"></div>
                  <div class="skeleton skeleton-text"></div>
                  <div class="skeleton skeleton-text-sm"></div>
                  <div style="display:flex;gap:8px;margin-top:12px;">
                    <div class="skeleton skeleton-badge"></div>
                    <div class="skeleton skeleton-badge"></div>
                    <div class="skeleton skeleton-badge"></div>
                  </div>
                  <div class="skeleton skeleton-btn" style="width:100%;margin-top:16px;"></div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ══════ SKILLS SECTION ══════ -->
        <section id="skills" style="display:none;">

          <!-- Section Heading -->
          <div class="section-heading">
            <div class="section-tag">
              <i class="ri-flashlight-line"></i> Expertise
            </div>
            <h2 class="section-title">Skills &amp; Technologies</h2>
            <p class="section-subtitle">Core technical stack, tools, and proficiencies</p>
          </div>
          <div id="skills-container">
            <!-- Skeleton: Skills category + 4 skill cards -->
            <div class="skill-category-container">
              <div class="skill-category-divider">
                <div class="skeleton skeleton-badge" style="width:160px;height:36px;border-radius:50px;"></div>
              </div>
              <div class="row g-4">
                <div class="col-12 col-md-6">
                  <div class="skeleton-skill-card">
                    <div style="display:flex;gap:16px;margin-bottom:16px;">
                      <div class="skeleton skeleton-skill-icon"></div>
                      <div style="flex:1;">
                        <div class="skeleton skeleton-title" style="width:60%;height:18px;margin-bottom:8px;"></div>
                        <div class="skeleton skeleton-text-sm" style="width:40%;"></div>
                      </div>
                    </div>
                    <div class="skeleton skeleton-text-xs" style="width:90px;margin-bottom:8px;"></div>
                    <div class="skeleton skeleton-skill-bar"></div>
                  </div>
                </div>
                <div class="col-12 col-md-6">
                  <div class="skeleton-skill-card">
                    <div style="display:flex;gap:16px;margin-bottom:16px;">
                      <div class="skeleton skeleton-skill-icon"></div>
                      <div style="flex:1;">
                        <div class="skeleton skeleton-title" style="width:50%;height:18px;margin-bottom:8px;"></div>
                        <div class="skeleton skeleton-text-sm" style="width:35%;"></div>
                      </div>
                    </div>
                    <div class="skeleton skeleton-text-xs" style="width:90px;margin-bottom:8px;"></div>
                    <div class="skeleton skeleton-skill-bar"></div>
                  </div>
                </div>
                <div class="col-12 col-md-6">
                  <div class="skeleton-skill-card">
                    <div style="display:flex;gap:16px;margin-bottom:16px;">
                      <div class="skeleton skeleton-skill-icon"></div>
                      <div style="flex:1;">
                        <div class="skeleton skeleton-title" style="width:55%;height:18px;margin-bottom:8px;"></div>
                        <div class="skeleton skeleton-text-sm" style="width:45%;"></div>
                      </div>
                    </div>
                    <div class="skeleton skeleton-text-xs" style="width:90px;margin-bottom:8px;"></div>
                    <div class="skeleton skeleton-skill-bar"></div>
                  </div>
                </div>
                <div class="col-12 col-md-6">
                  <div class="skeleton-skill-card">
                    <div style="display:flex;gap:16px;margin-bottom:16px;">
                      <div class="skeleton skeleton-skill-icon"></div>
                      <div style="flex:1;">
                        <div class="skeleton skeleton-title" style="width:65%;height:18px;margin-bottom:8px;"></div>
                        <div class="skeleton skeleton-text-sm" style="width:30%;"></div>
                      </div>
                    </div>
                    <div class="skeleton skeleton-text-xs" style="width:90px;margin-bottom:8px;"></div>
                    <div class="skeleton skeleton-skill-bar"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- ══════ EXPERIENCE SECTION ══════ -->
        <section id="experience" style="display:none;">

          <!-- Section Heading -->
          <div class="section-heading">
            <div class="section-tag">
              <i class="ri-briefcase-line"></i> Career Journey
            </div>
            <h2 class="section-title">Work Experience</h2>
            <p class="section-subtitle">Professional experience, roles, and responsibilities timeline</p>
          </div>
          <div class="exp-timeline" id="experience-container">
            <!-- Skeleton: 2 experience cards (replaced when loaded) -->
            <div class="exp-item exp-left">
              <div class="exp-card glass-effect">
                <div class="exp-header">
                  <div class="skeleton" style="width:56px;height:56px;border-radius:12px;flex-shrink:0;"></div>
                  <div style="flex:1;">
                    <div class="skeleton skeleton-title" style="width:60%;height:18px;margin-bottom:8px;"></div>
                    <div class="skeleton skeleton-text-sm" style="width:40%;"></div>
                  </div>
                </div>
                <div class="skeleton skeleton-text-sm" style="width:50%;margin:0.75rem 0;"></div>
                <div class="skeleton skeleton-text" style="width:90%;"></div>
                <div class="skeleton skeleton-text" style="width:75%;margin-top:6px;"></div>
              </div>
              <div class="exp-dot"></div>
            </div>
            <div class="exp-item exp-right">
              <div class="exp-card glass-effect">
                <div class="exp-header">
                  <div class="skeleton" style="width:56px;height:56px;border-radius:12px;flex-shrink:0;"></div>
                  <div style="flex:1;">
                    <div class="skeleton skeleton-title" style="width:55%;height:18px;margin-bottom:8px;"></div>
                    <div class="skeleton skeleton-text-sm" style="width:35%;"></div>
                  </div>
                </div>
                <div class="skeleton skeleton-text-sm" style="width:45%;margin:0.75rem 0;"></div>
                <div class="skeleton skeleton-text" style="width:85%;"></div>
              </div>
              <div class="exp-dot"></div>
            </div>
          </div>
        </section>

      </div>
    </main>

    <!-- ────────── HIRE ME SECTION ────────── -->
    <HireMe />

    <!-- ────────── FOOTER ────────── -->
    <Footer />

  </div>

  <!-- ══════ FLOATING GLASS DOCK (Top on Desktop, Bottom on Mobile) ══════ -->
  <div id="floating-dock" class="floating-dock" aria-label="Quick navigation">
    <div class="floating-dock-glass">
      <!-- Main Tabs -->
      <div class="floating-dock-tabs">
        <button class="floating-tab-btn active" data-target="#certificates" title="Certificates">
          <i class="ri-award-line"></i>
          <span class="dock-text">Certificates</span>
        </button>
        <button class="floating-tab-btn" data-target="#projects" title="Projects">
          <i class="ri-code-box-line"></i>
          <span class="dock-text">Projects</span>
        </button>
        <button class="floating-tab-btn" data-target="#skills" title="Skills">
          <i class="ri-flashlight-line"></i>
          <span class="dock-text">Skills</span>
        </button>
        <button class="floating-tab-btn" data-target="#experience" title="Experience">
          <i class="ri-briefcase-line"></i>
          <span class="dock-text">Experience</span>
        </button>
      </div>

      <!-- Certificate Sub-tabs (Programming / Networking) -->
      <div class="floating-sub-pills" id="floating-sub-pills">
        <div class="floating-divider"></div>
        <button class="floating-sub-btn active" id="dock-web-btn" title="Programming & Development">
          <i class="ri-code-s-slash-line"></i>
          <span class="sub-text">Web</span>
        </button>
        <button class="floating-sub-btn" id="dock-net-btn" title="Networking & Cyber Security">
          <i class="ri-shield-keyhole-line"></i>
          <span class="sub-text">Network</span>
        </button>
      </div>

      <!-- Actions: Integrated WhatsApp + Scroll To Top -->
      <div class="floating-dock-actions">
        <a href="#" id="dock-whatsapp-btn" class="floating-wa-btn" target="_blank" rel="noopener" title="Chat on WhatsApp" style="display:none;">
          <i class="ri-whatsapp-line"></i>
          <span class="dock-wa-text">WhatsApp</span>
        </a>
        <button class="floating-scroll-top" id="dock-scroll-top" title="Back to top">
          <i class="ri-arrow-up-s-line"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- ══════ NAVIGATION & DYNAMIC ISLAND LOGIC ══════ -->
  <script is:inline>
    (function() {
      const floatingDock = document.getElementById('floating-dock');
      const subPills = document.getElementById('floating-sub-pills');
      const dockWebBtn = document.getElementById('dock-web-btn');
      const dockNetBtn = document.getElementById('dock-net-btn');
      const originalWebTab = document.getElementById('web-tab');
      const originalNetTab = document.getElementById('net-tab');
      const dockScrollTop = document.getElementById('dock-scroll-top');

      function switchSection(targetId, shouldScroll) {
        // Update dock buttons
        document.querySelectorAll('.floating-tab-btn').forEach(b => {
          b.classList.toggle('active', b.dataset.target === targetId);
        });

        // Hide all sections, show active
        ['#certificates', '#projects', '#skills', '#experience'].forEach(s => {
          const el = document.querySelector(s);
          if (el) el.style.display = (s === targetId) ? 'block' : 'none';
        });

        // Toggle certs sub-pills in dock
        if (subPills) {
          subPills.style.display = (targetId === '#certificates') ? 'flex' : 'none';
        }

        // Smooth scroll to top of section if triggered and user is scrolled down
        if (shouldScroll) {
          const sectionEl = document.querySelector(targetId);
          if (sectionEl) {
            const offset = window.innerWidth > 768 ? 95 : 30;
            const top = sectionEl.getBoundingClientRect().top + window.scrollY - offset;
            window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
          }
        }
      }

      // Floating dock buttons click
      document.querySelectorAll('.floating-tab-btn').forEach(btn => {
        btn.addEventListener('click', () => switchSection(btn.dataset.target, true));
      });

      // Floating dock certificate sub-tabs
      function syncCertSub(type) {
        if (dockWebBtn) dockWebBtn.classList.toggle('active', type === 'web');
        if (dockNetBtn) dockNetBtn.classList.toggle('active', type === 'net');
      }

      if (dockWebBtn && originalWebTab) {
        dockWebBtn.addEventListener('click', () => {
          originalWebTab.click();
          syncCertSub('web');
        });
      }
      if (dockNetBtn && originalNetTab) {
        dockNetBtn.addEventListener('click', () => {
          originalNetTab.click();
          syncCertSub('net');
        });
      }
      if (originalWebTab) {
        originalWebTab.addEventListener('click', () => syncCertSub('web'));
      }
      if (originalNetTab) {
        originalNetTab.addEventListener('click', () => syncCertSub('net'));
      }

      // Scroll to top button
      if (dockScrollTop) {
        dockScrollTop.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      // Dynamic Island scroll observer: show/hide scroll-to-top button
      let ticking = false;
      function handleScroll() {
        if (dockScrollTop) {
          if (window.scrollY > 260) {
            dockScrollTop.classList.add('is-active');
          } else {
            dockScrollTop.classList.remove('is-active');
          }
        }
        ticking = false;
      }

      window.addEventListener('scroll', () => {
        if (!ticking) {
          requestAnimationFrame(handleScroll);
          ticking = true;
        }
      }, { passive: true });
      handleScroll();
    })();
  </script>

  <!-- Main App Logic -->
  <script src="../scripts/app.js"></script>

</BaseLayout>
